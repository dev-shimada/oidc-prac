{
    "name": "oidc-prac",
    "runArgs": [
        "--env-file",
        ".devcontainer/.env"
    ],
    "build": {
        "context": ".",
        "dockerfile": "Dockerfile",
        "target": "vscode"
    },
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "GitHub.copilot"
            ]
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder}/,target=/workspace,type=bind",
        "source=${env:HOME}/.claude,target=/root/.claude,type=bind"
    ],
    "remoteUser": "root",
    "forwardPorts": [49150, 49151],
    "postCreateCommand": "/bin/sh .devcontainer/post_create.sh"
}
